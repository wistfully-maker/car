<launch>
  <!--
    EXTERNAL_CONTRACT: deployment provides these packages in the same catkin
    workspace. Missing packages intentionally make roslaunch fail fast.
    Verified interfaces:
      ucar_fast_nav/pickup_navigation.launch accepts start_base, start_lidar,
      and cmd_vel_topic and owns pickup_goal.yaml loading.
      speech_command/speech_command.launch has no arguments and publishes
      recognized text on /question.
      qr_item_search/qr_item_search.launch accepts image_topic, publishes
      /cmd_vel, and does not start a camera or base.
      llm_spark/llm_spark.launch is the classification service launch.
      usb_cam/usb_cam_node is the sole shared camera node.

    start_base and start_lidar are downstream controls owned by the fast-nav
    include; they do not start hardware when start_fast_nav is false.
    start_velocity_arbiter=false is only for a deployment already providing an
    external equivalent sole arbiter. Navigation and QR remain isolated on
    /cmd_vel/navigation and /cmd_vel/qr; preflight ownership is task 6.

    This phase does NOT auto-start the unfinished avoidance navigation stage.
    After the post-speech handoff the orchestrator publishes
    /task/delivery_navigation_goal once and keeps /task/motion_mode at IDLE; a
    future avoidance module subscribes to it and reports back on
    /task/delivery_arrived.
  -->
  <arg name="start_fast_nav" default="true"/>
  <arg name="start_base" default="true"/>
  <arg name="start_lidar" default="true"/>
  <arg name="start_camera" default="true"/>
  <arg name="start_fast_nav_adapter" default="true"/>
  <arg name="start_readiness_gate" default="true"/>
  <arg name="start_speech" default="true"/>
  <arg name="start_qr" default="true"/>
  <arg name="start_llm" default="true"/>
  <arg name="start_orchestrator" default="true"/>
  <arg name="start_velocity_arbiter" default="true"/>
  <!-- 第二阶段：导航栈交接。true 时导航栈只由 handoff supervisor 持有；
       false 时回到第一部分直接启动 fast-nav 的行为。 -->
  <arg name="start_navigation_handoff" default="true"/>
  <!-- stop 栈外部提供时显式关闭（supervisor 不持有 stop launch）。 -->
  <arg name="start_stop_stack" default="true"/>
  <!-- 第三阶段巡线集成栈。false 时跳过第三阶段交接（不宣称比赛完成）。 -->
  <arg name="start_line_follow" default="true"/>
  <arg name="line_follow_launch"
       default="$(find line_follow_integration)/launch/phase3.launch"/>
  <arg name="phase3_config"
       default="$(find line_follow_integration)/config/phase3.yaml"/>
  <arg name="simulation_phase_enabled" default="true"/>
  <arg name="gazebo_phase_enabled" default="true"/>
  <arg name="gazebo_bridge_bind_host" default="0.0.0.0"/>
  <arg name="gazebo_bridge_port" default="1525"/>
  <arg name="gazebo_bridge_allowed_client_ip" default=""/>
  <arg name="gazebo_bridge_max_frame_bytes" default="8192"/>
  <arg name="legacy_nav_launch"
       default="$(find task_orchestrator)/launch/legacy_navigation_include.launch"/>
  <arg name="stop_integration_launch"
       default="$(find stop)/launch/mission_integration.launch"/>
  <!-- 导航模式：differential（车端已验证基线，默认）| omni（全向版配置层）。
       通过 supervisor 转发给两个导航栈；非 omni 值一律回落差速基线。 -->
  <arg name="navigation_mode" default="differential"/>

  <!-- QR 全局参数：qr_ 前缀 + 显式转发给 qr_item_search.launch（915aa37 契约）。
       qr_scan_window 默认 1.0 s 为实车解码更稳定的驻留值。 -->
  <arg name="qr_image_topic" default="/usb_cam/image_raw"/>
  <arg name="qr_start_debug_stream" default="false"/>
  <arg name="qr_debug_host" default="0.0.0.0"/>
  <arg name="qr_debug_port" default="8080"/>
  <arg name="qr_metrics_dir" default="$(env HOME)/qr_metrics"/>
  <arg name="qr_keyframe_dir" default="$(env HOME)/qr_keyframes"/>
  <arg name="qr_decode_scale" default="1.5"/>
  <arg name="qr_step_angle_deg" default="45.0"/>
  <arg name="qr_cruise_angular_speed" default="0.50"/>
  <arg name="qr_approach_angular_speed" default="0.20"/>
  <arg name="qr_approach_zone_deg" default="10.0"/>
  <arg name="qr_yaw_tolerance_deg" default="2.0"/>
  <arg name="qr_settled_angular_speed" default="0.03"/>
  <arg name="qr_settled_duration" default="0.20"/>
  <arg name="qr_scan_window" default="1.0"/>
  <arg name="qr_offset_angle_deg" default="22.5"/>
  <arg name="qr_max_passes" default="2"/>
  <arg name="qr_search_total_timeout" default="90.0"/>
  <arg name="qr_settling_timeout" default="3.0"/>
  <arg name="qr_heading_timeout" default="1.0"/>
  <arg name="qr_camera_timeout" default="1.0"/>

  <!-- LLM 全局参数 -->
  <arg name="llm_url"
       default="https://spark-api-open.xf-yun.com/x2/chat/completions"/>
  <arg name="llm_request_timeout" default="90.0"/>

  <!-- 编排阶段超时：显式传给 task_orchestrator.launch，覆盖 orchestrator.yaml。
       timeout_qr_search 默认 150.0 必须大于 QR 内部总搜索超时 90.0。
       第三阶段外层超时严格大于 line_follow_integration 内部 300/30/120 秒。 -->
  <arg name="timeout_dependency_ready" default="120.0"/>
  <arg name="timeout_pickup_navigation" default="300.0"/>
  <arg name="timeout_qr_search" default="150.0"/>
  <arg name="timeout_llm_classification" default="120.0"/>
  <arg name="timeout_speech" default="60.0"/>
  <arg name="timeout_gazebo" default="330.0"/>
  <arg name="timeout_line_navigation" default="310.0"/>
  <arg name="timeout_line_direction" default="35.0"/>
  <arg name="timeout_line_follow" default="125.0"/>

  <arg name="fast_nav_launch"
       default="$(find ucar_fast_nav)/launch/pickup_navigation.launch"/>
  <arg name="speech_launch"
       default="$(find speech_command)/launch/speech_command.launch"/>
  <arg name="qr_launch"
       default="$(find qr_item_search)/launch/qr_item_search.launch"/>
  <arg name="llm_launch"
       default="$(find llm_spark)/launch/llm_spark.launch"/>
  <arg name="orchestrator_launch"
       default="$(find task_orchestrator)/launch/task_orchestrator.launch"/>

  <!-- 交接模式下公共硬件由根 launch 一次性启动；导航进程组不含硬件，
       交接 supervisor 停止旧栈时不会误停底盘/雷达。 -->
  <group if="$(arg start_navigation_handoff)">
    <group if="$(arg start_base)">
      <include file="$(find ucar_controller)/launch/base_driver.launch"/>
    </group>
    <group if="$(arg start_lidar)">
      <include file="$(find ydlidar)/launch/ydlidar.launch"/>
    </group>
  </group>

  <group if="$(eval arg('start_navigation_handoff') == 'false')">
    <group if="$(arg start_fast_nav)">
      <!-- pickup_navigation.launch owns the single vendor pickup_goal.yaml load. -->
      <include file="$(arg fast_nav_launch)">
        <arg name="start_base" value="$(arg start_base)"/>
        <arg name="start_lidar" value="$(arg start_lidar)"/>
        <arg name="cmd_vel_topic" value="/cmd_vel/navigation"/>
      </include>
    </group>
    <!-- 非交接 + 全向模式：fast-nav 段经 dynamic_reconfigure 注入全向参数。 -->
    <group if="$(eval arg('navigation_mode') == 'omni' and arg('start_navigation_handoff') == 'false' and arg('start_fast_nav'))">
      <rosparam command="load"
                file="$(find task_orchestrator)/config/omni_fast_nav_teb.yaml"
                ns="/omni_fast_nav"/>
      <node pkg="task_orchestrator"
            type="omni_teb_applier_node.py"
            name="omni_teb_applier"
            output="screen">
        <param name="config_path" value="/omni_fast_nav/pickup_teb"/>
      </node>
    </group>
  </group>

  <group if="$(arg start_camera)">
    <!-- libswscale conversion warnings remain in usb_cam's ROS log, not the root console. -->
    <node pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="log"/>
  </group>

  <group if="$(arg start_speech)">
    <include file="$(arg speech_launch)"/>
  </group>

  <group if="$(arg start_qr)">
    <remap from="/cmd_vel" to="/cmd_vel/qr"/>
    <include file="$(arg qr_launch)">
      <arg name="image_topic" value="$(arg qr_image_topic)"/>
      <arg name="start_debug_stream" value="$(arg qr_start_debug_stream)"/>
      <arg name="debug_host" value="$(arg qr_debug_host)"/>
      <arg name="debug_port" value="$(arg qr_debug_port)"/>
      <arg name="metrics_dir" value="$(arg qr_metrics_dir)"/>
      <arg name="keyframe_dir" value="$(arg qr_keyframe_dir)"/>
      <arg name="decode_scale" value="$(arg qr_decode_scale)"/>
      <arg name="step_angle_deg" value="$(arg qr_step_angle_deg)"/>
      <arg name="cruise_angular_speed" value="$(arg qr_cruise_angular_speed)"/>
      <arg name="approach_angular_speed" value="$(arg qr_approach_angular_speed)"/>
      <arg name="approach_zone_deg" value="$(arg qr_approach_zone_deg)"/>
      <arg name="yaw_tolerance_deg" value="$(arg qr_yaw_tolerance_deg)"/>
      <arg name="settled_angular_speed" value="$(arg qr_settled_angular_speed)"/>
      <arg name="settled_duration" value="$(arg qr_settled_duration)"/>
      <arg name="scan_window" value="$(arg qr_scan_window)"/>
      <arg name="offset_angle_deg" value="$(arg qr_offset_angle_deg)"/>
      <arg name="max_passes" value="$(arg qr_max_passes)"/>
      <arg name="search_total_timeout" value="$(arg qr_search_total_timeout)"/>
      <arg name="settling_timeout" value="$(arg qr_settling_timeout)"/>
      <arg name="heading_timeout" value="$(arg qr_heading_timeout)"/>
      <arg name="camera_timeout" value="$(arg qr_camera_timeout)"/>
    </include>
  </group>

  <group if="$(arg start_llm)">
    <include file="$(arg llm_launch)">
      <arg name="url" value="$(arg llm_url)"/>
      <arg name="request_timeout" value="$(arg llm_request_timeout)"/>
    </include>
  </group>

  <group if="$(arg start_orchestrator)">
    <include file="$(arg orchestrator_launch)">
      <arg name="enable_task_orchestrator" value="true"/>
      <arg name="enable_voice_adapter" value="true"/>
      <arg name="enable_tts_bridge" value="true"/>
      <arg name="enable_fast_nav_adapter" value="false"/>
      <arg name="enable_readiness_gate" value="false"/>
      <arg name="enable_velocity_arbiter" value="false"/>
      <arg name="enable_gazebo_bridge_server"
           value="$(arg gazebo_phase_enabled)"/>
      <arg name="simulation_phase_enabled"
           value="$(arg simulation_phase_enabled)"/>
      <arg name="gazebo_phase_enabled"
           value="$(arg gazebo_phase_enabled)"/>
      <arg name="gazebo_bridge_bind_host"
           value="$(arg gazebo_bridge_bind_host)"/>
      <arg name="gazebo_bridge_port"
           value="$(arg gazebo_bridge_port)"/>
      <arg name="gazebo_bridge_allowed_client_ip"
           value="$(arg gazebo_bridge_allowed_client_ip)"/>
      <arg name="gazebo_bridge_max_frame_bytes"
           value="$(arg gazebo_bridge_max_frame_bytes)"/>
      <arg name="timeout_dependency_ready" value="$(arg timeout_dependency_ready)"/>
      <arg name="timeout_pickup_navigation" value="$(arg timeout_pickup_navigation)"/>
      <arg name="timeout_qr_search" value="$(arg timeout_qr_search)"/>
      <arg name="timeout_llm_classification" value="$(arg timeout_llm_classification)"/>
      <arg name="timeout_speech" value="$(arg timeout_speech)"/>
      <arg name="timeout_gazebo" value="$(arg timeout_gazebo)"/>
      <arg name="phase3_config" value="$(arg phase3_config)"/>
      <arg name="timeout_line_navigation" value="$(arg timeout_line_navigation)"/>
      <arg name="timeout_line_direction" value="$(arg timeout_line_direction)"/>
      <arg name="timeout_line_follow" value="$(arg timeout_line_follow)"/>
    </include>
  </group>

  <group if="$(arg start_line_follow)">
    <!-- 第三阶段常驻轻量节点：相机适配/导航适配/巡线监管器。
         不含任何硬件启动，也不启动原始 YOLO 一键 launch。 -->
    <include file="$(arg line_follow_launch)">
      <arg name="phase3_config" value="$(arg phase3_config)"/>
    </include>
  </group>

  <group if="$(arg start_fast_nav_adapter)">
    <include file="$(arg orchestrator_launch)">
      <arg name="enable_task_orchestrator" value="false"/>
      <arg name="enable_voice_adapter" value="false"/>
      <arg name="enable_tts_bridge" value="false"/>
      <arg name="enable_fast_nav_adapter" value="true"/>
      <arg name="enable_readiness_gate" value="false"/>
      <arg name="enable_velocity_arbiter" value="false"/>
    </include>
  </group>

  <group if="$(arg start_readiness_gate)">
    <include file="$(arg orchestrator_launch)">
      <arg name="enable_task_orchestrator" value="false"/>
      <arg name="enable_voice_adapter" value="false"/>
      <arg name="enable_tts_bridge" value="false"/>
      <arg name="enable_fast_nav_adapter" value="false"/>
      <arg name="enable_readiness_gate" value="true"/>
      <arg name="enable_velocity_arbiter" value="false"/>
    </include>
  </group>

  <group if="$(arg start_velocity_arbiter)">
    <include file="$(arg orchestrator_launch)">
      <arg name="enable_task_orchestrator" value="false"/>
      <arg name="enable_voice_adapter" value="false"/>
      <arg name="enable_tts_bridge" value="false"/>
      <arg name="enable_fast_nav_adapter" value="false"/>
      <arg name="enable_readiness_gate" value="false"/>
      <arg name="enable_velocity_arbiter" value="true"/>
    </include>
  </group>

  <group if="$(arg start_navigation_handoff)">
    <!-- 导航栈交接 supervisor：两个导航 launch 的唯一生命周期 owner。 -->
    <group if="$(arg start_stop_stack)">
    <include file="$(arg orchestrator_launch)">
      <arg name="enable_task_orchestrator" value="false"/>
      <arg name="enable_voice_adapter" value="false"/>
      <arg name="enable_tts_bridge" value="false"/>
      <arg name="enable_fast_nav_adapter" value="false"/>
      <arg name="enable_readiness_gate" value="false"/>
      <arg name="enable_velocity_arbiter" value="false"/>
      <arg name="enable_navigation_handoff_supervisor" value="true"/>
      <arg name="legacy_nav_launch" value="$(arg legacy_nav_launch)"/>
      <arg name="stop_integration_launch" value="$(arg stop_integration_launch)"/>
      <arg name="legacy_nav_mode" value="$(arg navigation_mode)"/>
      <arg name="stop_integration_nav_mode" value="$(arg navigation_mode)"/>
    </include>
    </group>
    <group unless="$(arg start_stop_stack)">
      <include file="$(arg orchestrator_launch)">
        <arg name="enable_task_orchestrator" value="false"/>
        <arg name="enable_voice_adapter" value="false"/>
        <arg name="enable_tts_bridge" value="false"/>
        <arg name="enable_fast_nav_adapter" value="false"/>
        <arg name="enable_readiness_gate" value="false"/>
        <arg name="enable_velocity_arbiter" value="false"/>
        <arg name="enable_navigation_handoff_supervisor" value="true"/>
        <arg name="legacy_nav_launch" value="$(arg legacy_nav_launch)"/>
        <arg name="stop_integration_launch" value=""/>
        <arg name="legacy_nav_mode" value="$(arg navigation_mode)"/>
        <arg name="stop_integration_nav_mode" value="$(arg navigation_mode)"/>
      </include>
    </group>
  </group>
</launch>
