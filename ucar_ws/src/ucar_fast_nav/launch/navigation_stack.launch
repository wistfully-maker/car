<launch>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="map_file" default="$(find ucar_fast_nav)/maps/002.yaml"/>

  <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)" output="screen">
    <param name="frame_id" value="map"/>
  </node>

  <node name="lidar_loc" pkg="jie_ware" type="lidar_loc" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="laser_frame" value="laser_frame"/>
    <param name="laser_topic" value="scan"/>
  </node>

  <node name="move_base" pkg="move_base" type="move_base"
        respawn="false" output="screen">
    <remap from="/cmd_vel" to="$(arg cmd_vel_topic)"/>
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>

    <rosparam file="$(find ucar_fast_nav)/config/move_base/move_base_params.yaml" command="load"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/global_planner_params.yaml" command="load"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/teb_local_planner_params.yaml" command="load"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find ucar_fast_nav)/config/move_base/global_costmap_params.yaml" command="load"/>
  </node>
</launch>
