<launch>
  <!-- ====== 动态障碍物检测追踪 + 安全监控 ====== -->

  <!-- 1. 动态障碍物追踪节点 -->
  <node pkg="dynamic_obstacle" type="dynamic_obstacle_tracker.py"
        name="dynamic_obstacle_tracker" output="screen">

    <param name="cluster_tolerance" value="0.15"/>
    <param name="min_cluster_size" value="3"/>
    <param name="static_map_threshold" value="0.3"/>
    <param name="map_frame" value="map"/>
    <param name="robot_frame" value="base_footprint"/>
  </node>

  <!-- 2. 安全监控节点 -->
  <node pkg="dynamic_obstacle" type="safety_monitor.py"
        name="safety_monitor" output="screen">

    <param name="ttc_emergency_stop" value="0.5"/>
    <param name="ttc_slowdown" value="1.0"/>
    <param name="ttc_caution" value="2.0"/>
    <param name="safety_slowdown_speed" value="0.3"/>
    <param name="caution_speed" value="0.8"/>
    <param name="robot_safety_radius" value="0.28"/>
    <param name="obstacle_default_radius" value="0.3"/>
  </node>

</launch>
